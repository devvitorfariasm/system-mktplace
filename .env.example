# Copie para .env e ajuste. Nunca commite o .env.
POSTGRES_USER=mktplace
POSTGRES_PASSWORD=mktplace
# Token exigido no header X-Admin-Token das rotas /admin/** (chaos, DLQ, reset de offsets)
ADMIN_TOKEN=change-me-admin-token
# Fuso usado para formatar datas nas respostas (ISO-8601 com offset)
APP_ZONE=America/Sao_Paulo
